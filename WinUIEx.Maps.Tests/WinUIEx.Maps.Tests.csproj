<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>WinUIEx.Maps.Tests</UserSecretsId>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS8305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Maps.Search" Version="1.0.0-beta.5" />
    <PackageReference Include="Azure.Maps.Routing" Version="1.0.0-beta.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.1-experimental" />
    <PackageReference Include="MSTest" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinUIEx.Maps\WinUIEx.Maps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="TestApplication.xaml" />
    <ApplicationDefinition Include="TestApplication.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\WindowsMapsSample\Models\*.cs" Link="WindowsMapsSample\Models\%(Filename)%(Extension)" />
    <Content Include="..\WindowsMapsSample\Assets\**\*.svg" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\WindowsMapsSample\Services\*.cs" Link="WindowsMapsSample\Services\%(Filename)%(Extension)" />
    <Compile Include="..\WindowsMapsSample\ViewModels\*.cs" Link="WindowsMapsSample\ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\WindowsMapsSample\Controls\*.cs" Link="WindowsMapsSample\Controls\%(Filename)%(Extension)" />
    <Compile Include="..\WindowsMapsSample\MainPage.xaml.cs" Link="WindowsMapsSample\MainPage.xaml.cs" />
    <Compile Include="..\WindowsMapsSample\MainPage.Inking.cs" Link="WindowsMapsSample\MainPage.Inking.cs" />
    <Compile Include="..\WindowsMapsSample\MainPage.SearchTabs.cs" Link="WindowsMapsSample\MainPage.SearchTabs.cs" />
    <Page Include="..\WindowsMapsSample\MainPage.xaml" Link="WindowsMapsSample\MainPage.xaml" />
    <Page Include="..\WindowsMapsSample\Themes\Generic.xaml" Link="WindowsMapsSample\Themes\Generic.xaml" />
  </ItemGroup>

</Project>
