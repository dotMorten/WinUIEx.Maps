                                                    <Path Data="M7 14.907a7.418 7.418 0 0 1 1-1.11V3H7zM17 6.5c0 4.896-2.608 6.306-4.91 7.55C9.897 15.237 8 16.262 8 20v1H7v-1c0-4.333 2.347-5.602 4.616-6.83C13.87 11.953 16 10.8 16 6.5V3.707l-1.64 1.64-.707-.706L16.5 1.793l2.847 2.848-.707.707L17 3.708z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind ManeuverIcon, Converter={StaticResource RouteStepIconConverter}, ConverterParameter=ExitRight}" />
                                                    <Path Data="M4 3h1v2.155a9.762 9.762 0 0 1 14.333.366l-.526.91A8.773 8.773 0 0 0 5.581 6H8v1H4zm16.4 4.671l-2 3.465.866.5 1.187-2.057A8.767 8.767 0 0 1 13.18 20.71l.536.929a9.752 9.752 0 0 0 7.73-12.21l1.918 1.108.5-.867zm-9.096 13.791l-2-3.464-.866.5 1.127 1.952A8.761 8.761 0 0 1 3.738 9H2.674a9.778 9.778 0 0 0 6.688 12.429L7.34 22.596l.5.866z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind ManeuverIcon, Converter={StaticResource RouteStepIconConverter}, ConverterParameter=RoundaboutLeft}" />
                                                    <Path Data="M20 7h-4V6h2.42a8.773 8.773 0 0 0-13.227.431l-.526-.91A9.762 9.762 0 0 1 19 5.155V3h1zM.136 9.671l.5.867L2.553 9.43a9.752 9.752 0 0 0 7.731 12.209l.536-.929A8.767 8.767 0 0 1 3.547 9.58l1.187 2.057.866-.5-2-3.465zM16.16 23.462l.5-.866-2.022-1.167A9.778 9.778 0 0 0 21.326 9h-1.064a8.761 8.761 0 0 1-5.827 11.45l1.127-1.952-.866-.5-2 3.464z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind ManeuverIcon, Converter={StaticResource RouteStepIconConverter}, ConverterParameter=RoundaboutRight}" />
                                                </Grid>
                                                <StackPanel Grid.Column="2" Spacing="4" Margin="0,10" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Distance}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind Instruction}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                            <ScrollViewer x:Name="FavoritesPane" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Saved places" FontWeight="SemiBold" />
                                    <TextBlock Text="Save a search result or a pin on the map to find it here. Saved places are available the next time you open the app."
                                               TextWrapping="Wrap" />
                                    <ListView x:Name="FavoritesList" ItemTemplate="{StaticResource PlaceTemplate}"
                                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="Place_Clicked" AutomationProperties.Name="Saved places" />
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer x:Name="SettingsPane" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Azure Maps account" FontWeight="SemiBold" />
                                    <TextBlock Text="Your account key is stored in this app's local settings, not a credential vault. Never share it. Azure Maps usage may incur charges."
                                               TextWrapping="Wrap" />
                                    <Button Content="Replace account key" Click="ReplaceKey_Click" />
                                    <Button Content="Remove account key" Click="RemoveKey_Click" />
                                    <TextBlock Text="Appearance" FontWeight="SemiBold" />
                                    <ComboBox x:Name="ThemePicker" Header="App theme" SelectedIndex="0" SelectionChanged="Theme_Changed">
                                        <ComboBoxItem x:Name="SystemThemeOption" Content="Use Windows setting" />
                                        <ComboBoxItem x:Name="LightThemeOption" Content="Light" />
                                        <ComboBoxItem x:Name="DarkThemeOption" Content="Dark" />
                                    </ComboBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
                <controls:MapNavigationControl x:Name="Navigation" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16"
                    Heading="{x:Bind Map.Heading, Mode=OneWay}" TiltRequested="Navigation_TiltRequested"
                    LocateRequested="Navigation_LocateRequested" NorthUpRequested="Navigation_NorthUpRequested"
                    ZoomInRequested="Navigation_ZoomInRequested" ZoomOutRequested="Navigation_ZoomOutRequested" />
            </Grid>
        </Grid>
        <Grid x:Name="Onboarding" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer>
                <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,80" Spacing="20">
                    <Image Source="ms-appx:///Assets/MapsIcon.svg" Width="80" Height="80" />
                    <TextBlock Text="Find your way." Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Welcome to Windows Maps Sample" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Connect your Azure Maps account to explore places and plan a journey. Enter a primary or secondary subscription key, not an Entra access token."
                               TextWrapping="Wrap" />
                    <PasswordBox x:Name="TokenInput" Header="Azure Maps account key" PasswordRevealMode="Peek"
                                 AutomationProperties.AutomationId="AzureMapsTokenInput" PasswordChanged="Token_Changed" />
                    <TextBlock Text="After validation, your key is saved in local app settings on this device. Azure Maps requests may incur charges."
                               TextWrapping="Wrap" FontSize="12" />
                    <HyperlinkButton Content="Get an Azure Maps account key"
                                     NavigateUri="https://learn.microsoft.com/azure/azure-maps/how-to-manage-account-keys" />
                    <InfoBar x:Name="TokenStatus" IsOpen="False" IsClosable="False" Severity="Error"
                             AutomationProperties.LiveSetting="Polite" />
                    <ProgressRing x:Name="TokenProgress" IsActive="False" Visibility="Collapsed" Width="24" Height="24" />
                    <Button x:Name="ValidateButton" Content="Validate and continue" Click="ValidateToken_Click"
                            IsEnabled="False" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="ValidateTokenButton" />
                    <Button Content="Exit" Click="Exit_Click" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
