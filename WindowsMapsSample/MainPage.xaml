                                                    <Path Data="M19.201 8.494l-2.847-2.848-.707.707 1.647 1.648h-4.451A6.901 6.901 0 0 0 6 14.929v6.07h1v-6.07A5.901 5.901 0 0 1 12.843 9h4.437l-1.634 1.634.707.707z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind ManeuverIcon, Converter={StaticResource RouteStepIconConverter}, ConverterParameter=TurnRight}" />
