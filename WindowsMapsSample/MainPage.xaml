                                                    <Path Data="M12 17.174a15.253 15.253 0 0 0 1-1.793V21h-1zm3.348-11.533L12.5 2.793 9.652 5.641l.707.707L12 4.707v4.116a12.802 12.802 0 0 1-6.857 11.36l.464.884A13.798 13.798 0 0 0 13 8.823V4.707l1.64 1.64z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind ManeuverIcon, Converter={StaticResource RouteStepIconConverter}, ConverterParameter=MergeRight}" />
