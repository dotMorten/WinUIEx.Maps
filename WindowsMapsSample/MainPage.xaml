<Page
    x:Class="WindowsMapsSample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WindowsMapsSample.Models"
    xmlns:controls="using:WindowsMapsSample.Controls"
    xmlns:maps="using:WinUIEx.Maps">
    <Page.Resources>
        <controls:RouteStepIconConverter x:Key="RouteStepIconConverter" />
        <Flyout x:Key="TrafficIncidentFlyout">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="Padding" Value="16" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <StackPanel x:Name="TrafficIncidentContent" Width="320" Spacing="14"
                        AutomationProperties.AutomationId="TrafficIncidentDetails">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock x:Name="TrafficIncidentTitle" Text="Traffic incident" FontWeight="SemiBold" FontSize="16"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="TrafficIncidentDelay" Grid.Column="1" FontWeight="SemiBold" FontSize="16"
                               MaxWidth="140" TextWrapping="Wrap" TextAlignment="Right"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Grid>
                <TextBlock x:Name="TrafficIncidentDescription" FontSize="16"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <StackPanel x:Name="TrafficIncidentTimes" Spacing="2">
                    <TextBlock x:Name="TrafficIncidentStart" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TrafficIncidentEnd" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Flyout>
        <DataTemplate x:Key="EndpointSuggestionTemplate" x:DataType="models:EndpointSuggestion">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="10" Padding="4,8">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                <TextBlock Grid.Column="1" Text="{x:Bind Label}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <MenuFlyout x:Key="MapContextMenu" Closed="MapContextMenu_Closed">
            <MenuFlyoutItem IsEnabled="False" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Drop pin" Click="DropPin_Click" AutomationProperties.AutomationId="DropPin">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="MapPin" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="PinContextMenu" Closed="PinContextMenu_Closed">
            <MenuFlyoutItem Text="Directions to here" Click="PinDirectionsTo_Click" AutomationProperties.AutomationId="PinDirectionsTo">
                <MenuFlyoutItem.Icon>
                    <PathIcon Data="F0 M10,0 L20,10 10,20 0,10 Z M10,2 L2,10 10,18 18,10 Z M6,14 L6,8 11,8 11,5 16,9 11,13 11,10 8,10 8,14 Z" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Save place" Click="PinSave_Click" AutomationProperties.AutomationId="PinSave">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Favorite" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Delete saved pin" Click="PinDelete_Click" AutomationProperties.AutomationId="PinDelete">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <DataTemplate x:Key="PlaceTemplate" x:DataType="models:Place">
            <Grid Padding="4,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Address}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Tag="{x:Bind}" Click="EditFavoriteName_Click" AutomationProperties.Name="Rename saved place"
                        ToolTipService.ToolTip="Rename saved place" Background="Transparent" BorderThickness="0">
                    <SymbolIcon Symbol="Edit" />
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SearchResultTemplate" x:DataType="models:Place">
            <Grid Padding="0,8" ColumnDefinitions="48,*" ColumnSpacing="10">
                <Border Width="48" Height="56" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xE707;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Address}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="Directions" Padding="0" Tag="{x:Bind}" Click="ResultDirections_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="Shell" Visibility="Collapsed" RowDefinitions="Auto,*">
            <Grid x:Name="TopCommands" Background="{ThemeResource MapToolbarBackgroundBrush}" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SearchNavigation" Style="{StaticResource MapCommandButton}" Click="SearchPane_Click"
                            AutomationProperties.Name="Search" ToolTipService.ToolTip="Search">
                        <FontIcon Glyph="&#xE721;" FontSize="20" />
                    </Button>
                    <Button x:Name="DirectionsNavigation" Style="{StaticResource MapCommandButton}" Click="DirectionsPane_Click"
                            AutomationProperties.Name="Directions" ToolTipService.ToolTip="Directions">
                        <PathIcon Data="F0 M10,0 L20,10 10,20 0,10 Z M10,2 L2,10 10,18 18,10 Z M6,14 L6,8 11,8 11,5 16,9 11,13 11,10 8,10 8,14 Z" Width="20" Height="20" />
                    </Button>
                </StackPanel>
                <TabView x:Name="SearchTabs" Grid.Column="1" VerticalAlignment="Bottom" Visibility="Collapsed"
                         IsAddTabButtonVisible="False"
                         TabWidthMode="SizeToContent" SelectionChanged="SearchTabs_SelectionChanged"
                         TabCloseRequested="SearchTabs_TabCloseRequested"
                         AutomationProperties.Name="Open searches and places" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel x:Name="InkTools" Visibility="Collapsed" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center" ToolTipService.ToolTip="Draw on the map. Done keeps ink anchored to its locations.">
                        <InkToolbar x:Name="DrawingToolbar" TargetInkCanvas="{x:Bind MapInk}" />
                        <Button Click="ClearInk_Click" AutomationProperties.AutomationId="ClearInk"
                                AutomationProperties.Name="Clear all ink" ToolTipService.ToolTip="Clear all ink">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                        <Button Content="Done" Click="FinishInk_Click" AutomationProperties.AutomationId="FinishInk" />
                    </StackPanel>
                    <Button x:Name="FavoritesNavigation" Style="{StaticResource MapCommandButton}" Click="FavoritesPane_Click"
                            AutomationProperties.Name="Saved places" ToolTipService.ToolTip="Saved places">
                        <FontIcon Glyph="&#xE734;" FontSize="20" />
                    </Button>
                    <controls:MapStylePicker x:Name="StylePicker" />
                    <Button Style="{StaticResource MapCommandButton}" Click="InkNavigation_Click"
                            AutomationProperties.Name="Windows Ink" ToolTipService.ToolTip="Windows Ink">
                        <FontIcon Glyph="&#xEDC6;" FontSize="20" />
                    </Button>
                    <Button Style="{StaticResource MapCommandButton}" Click="SettingsPane_Click"
                            AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="20" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <maps:MapControl x:Name="Map" MapStyle="Blank" />
                <InkCanvas x:Name="MapInk" Visibility="Collapsed" />
                <Border x:Name="Pane" Width="360" Margin="12,12,0,48" HorizontalAlignment="Left"
                        Background="{ThemeResource MapPanelBackgroundBrush}" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="2">
                    <Grid x:Name="PaneContent" RowDefinitions="Auto,Auto,*" Padding="16">
                        <Grid x:Name="PaneHeader" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="PaneTitle" Text="Search" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Click="ClosePane_Click" AutomationProperties.Name="Close pane"
                                    Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                        <InfoBar x:Name="Status" Grid.Row="1" Margin="0,8" IsOpen="False" IsClosable="True"
                                 AutomationProperties.LiveSetting="Polite" />
                        <Grid Grid.Row="2">
                            <ScrollViewer x:Name="SearchPane" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12">
                                    <StackPanel x:Name="SearchOverview" Spacing="12">
                                    <AutoSuggestBox x:Name="SearchInput" PlaceholderText="Search for a place or address"
                                                    AutomationProperties.Name="Search for a place or address"
                                                    TextChanged="Search_TextChanged" SuggestionChosen="Suggestion_Chosen"
                                                    QuerySubmitted="Search_QuerySubmitted" QueryIcon="Find" />
                                    <ListView x:Name="SearchResults" ItemTemplate="{StaticResource SearchResultTemplate}"
                                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="Place_Clicked"
                                              AutomationProperties.Name="Search results" />
                                    </StackPanel>
                                    <StackPanel x:Name="PlaceDetails" Visibility="Collapsed" Spacing="12">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="16" CornerRadius="2">
                                            <StackPanel Spacing="12">
                                                <Button x:Name="BackToResults" Click="BackToResults_Click" Background="Transparent" BorderThickness="0"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        AutomationProperties.Name="Back to search results" Padding="4">
                                                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                                                </Button>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock x:Name="PlaceName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    <Button x:Name="EditSelectedFavoriteNameButton" Grid.Column="1" Visibility="Collapsed"
                                                            Click="EditSelectedFavoriteName_Click" AutomationProperties.Name="Rename saved place"
                                                            ToolTipService.ToolTip="Rename saved place" Background="Transparent" BorderThickness="0"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                                        <SymbolIcon Symbol="Edit" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button x:Name="FavoriteButton" Click="Favorite_Click" AutomationProperties.Name="Save place"
                                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon x:Name="FavoriteGlyph" Glyph="&#xE734;" FontSize="20" />
                                                    <TextBlock x:Name="FavoriteLabel" Text="Save place" FontSize="12" TextWrapping="Wrap" MaxWidth="104" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="DirectionsToPlaceSecondaryButton" Grid.Column="1" Click="DirectionsToPlace_Click"
                                                    AutomationProperties.Name="Directions to here" Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="F0 M10,0 L20,10 10,20 0,10 Z M10,2 L2,10 10,18 18,10 Z M6,14 L6,8 11,8 11,5 16,9 11,13 11,10 8,10 8,14 Z" Width="20" Height="20" />
                                                    <TextBlock Text="Directions to here" FontSize="12" TextWrapping="Wrap" MaxWidth="104" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8" Padding="4,8">
                                            <FontIcon Glyph="&#xE707;" FontSize="18" VerticalAlignment="Top" />
                                            <TextBlock x:Name="PlaceAddress" Grid.Column="1" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid x:Name="DirectionsPane" Visibility="Collapsed" RowDefinitions="Auto,*">
                                <StackPanel Spacing="12">
                                    <SelectorBar x:Name="TravelModePicker" SelectionChanged="TravelMode_Changed"
                                                 AutomationProperties.Name="Travel mode">
                                        <SelectorBarItem x:Name="DrivingMode" Text="Driving" IsSelected="True">
                                            <SelectorBarItem.Icon>
                                                <PathIcon Data="F0 M4,2 L16,2 19,8 19,18 16,18 16,16 4,16 4,18 1,18 1,8 Z M5,4 L3,8 17,8 15,4 Z M4,10 L4,13 7,13 7,10 Z M13,10 L13,13 16,13 16,10 Z" />
                                            </SelectorBarItem.Icon>
                                        </SelectorBarItem>
                                        <SelectorBarItem x:Name="WalkingMode" Text="Walking">
                                            <SelectorBarItem.Icon>
                                                <PathIcon Data="M11,0 A2,2 0 1 1 11,4 A2,2 0 1 1 11,0 Z M8,5 L12,5 15,8 18,8 18,10 14,10 12,8 11,12 14,14 14,20 12,20 12,16 8,13 6,20 3,20 6,11 7,8 4,10 4,13 2,13 2,8 Z" />
                                            </SelectorBarItem.Icon>
                                        </SelectorBarItem>
                                    </SelectorBar>
                                    <StackPanel x:Name="RouteEditor" Spacing="12">
                                    <Grid ColumnDefinitions="28,*,40" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="4">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#16835D" VerticalAlignment="Center">
                                            <TextBlock Text="A" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <AutoSuggestBox x:Name="OriginInput" Grid.Column="1" PlaceholderText="Choose starting point"
                                                    AutomationProperties.Name="Starting point"
                                                    ItemTemplate="{StaticResource EndpointSuggestionTemplate}" GotFocus="Endpoint_GotFocus"
                                                    TextChanged="Search_TextChanged" SuggestionChosen="Suggestion_Chosen"
                                                    QueryIcon="Find" QuerySubmitted="Search_QuerySubmitted" />
                                        <Border Grid.Row="1" Width="24" Height="24" CornerRadius="12" Background="#C43C31" VerticalAlignment="Center">
                                            <TextBlock Text="B" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <AutoSuggestBox x:Name="DestinationInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Choose destination"
                                                    AutomationProperties.Name="Destination"
                                                    ItemTemplate="{StaticResource EndpointSuggestionTemplate}" GotFocus="Endpoint_GotFocus"
                                                    TextChanged="Search_TextChanged" SuggestionChosen="Suggestion_Chosen"
                                                    QueryIcon="Find" QuerySubmitted="Search_QuerySubmitted" />
                                        <Button Grid.Column="2" Grid.RowSpan="2" Padding="8" VerticalAlignment="Center"
                                                Click="Swap_Click" AutomationProperties.Name="Swap endpoints" ToolTipService.ToolTip="Swap endpoints">
                                            <PathIcon Data="M5,0 L9,4 6,4 6,17 4,17 4,4 1,4 Z M15,20 L11,16 14,16 14,3 16,3 16,16 19,16 Z" Width="20" Height="20" />
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="GetDirectionsButton" Content="Get directions" Click="Route_Click" Style="{StaticResource AccentButtonStyle}" />
                                        <Button Content="Clear" Click="ClearRoute_Click" />
                                    </StackPanel>
                                    <ProgressBar x:Name="RouteProgress" Visibility="Collapsed"
                                                 AutomationProperties.Name="Finding a route" />
                                    </StackPanel>
                                    <Border x:Name="RouteCard" Visibility="Collapsed" Padding="12,8" BorderThickness="3,0,0,0"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="RouteSummary" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="Route preview only. Not turn-by-turn navigation." TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="EditDirections" Content="Edit directions" Click="EditDirections_Click" />
                                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10" Margin="0,10,0,0">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#16835D">
                                                    <TextBlock Text="A" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="RouteOriginLabel" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <ListView x:Name="Itinerary" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="Step_Selected" AutomationProperties.Name="Route steps">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RouteStep">
                                            <Grid ColumnDefinitions="8,32,*" ColumnSpacing="10" MinHeight="68">
                                                <Border Width="3" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
