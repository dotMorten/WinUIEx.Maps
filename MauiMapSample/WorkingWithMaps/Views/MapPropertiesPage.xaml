<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="WorkingWithMaps.Views.MapPropertiesPage"
             Title="Map properties demo">
    <Grid Margin="10" RowDefinitions="*,Auto,Auto">
        <maps:Map x:Name="map"
                  AutomationId="MapPropertiesMap"
                  MapClicked="OnMapClicked" />
        <Grid Grid.Row="1" ColumnDefinitions="0.8*,0.2*"
              RowDefinitions="Auto,Auto,Auto,Auto">
            <Label Text="Pan enabled:"
                   VerticalTextAlignment="Center" />
            <CheckBox Grid.Column="1"
                      x:Name="scrollEnabledCheckBox"
                      AutomationId="MapPanToggle"
                      SemanticProperties.Description="Allow map panning"
                      IsChecked="True" />
            <Label Grid.Row="1"
                   Text="Zoom enabled:"
                   VerticalTextAlignment="Center" />
            <CheckBox Grid.Row="1"
                      Grid.Column="1"
                      x:Name="zoomEnabledCheckBox"
                      AutomationId="MapZoomToggle"
                      SemanticProperties.Description="Allow map zooming"
                      IsChecked="True" />
            <Label Grid.Row="2"
                   Text="Show user:"
                   VerticalTextAlignment="Center" />
            <CheckBox Grid.Row="2"
                      Grid.Column="1"
                      x:Name="showUserCheckBox"
                      AutomationId="MapUserToggle"
                      SemanticProperties.Description="Show user location"
                      CheckedChanged="OnCheckBoxCheckedChanged"/>
            <Label Grid.Row="3"
                   Text="Show traffic:"
                   VerticalTextAlignment="Center" />
            <CheckBox Grid.Row="3"
                      Grid.Column="1"
                      x:Name="showTrafficCheckBox"
                      AutomationId="MapTrafficToggle"
                      SemanticProperties.Description="Show traffic"
                      CheckedChanged="OnCheckBoxCheckedChanged" />
        </Grid>
        <Label x:Name="statusLabel" Grid.Row="2" />
    </Grid>
</ContentPage>
