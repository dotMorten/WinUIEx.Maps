<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIEx.Maps">

    <Style TargetType="local:MapControl" >
        <Setter Property="IsDoubleTapEnabled" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter
            Property="ManipulationMode"
            Value="TranslateX, TranslateY, Scale, Rotate, TranslateInertia"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MapControl">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusVisual.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <!-- Unparented IconElement instances are briefly hosted here for
                                 UI-thread RenderTargetBitmap rasterization. The map surface
                                 covers this non-interactive staging host. -->
                            <ContentControl
                                x:Name="PART_IconHost"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"/>
                            <SwapChainPanel x:Name="PART_SwapChain"/>
                            <TextBlock
                                x:Name="PART_MapState"
                                Width="1"
                                Height="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Opacity="0"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="MapState"
                                AutomationProperties.LiveSetting="Polite"/>
                            <InfoBar
                                x:Name="PART_AzureAuthenticationInfoBar"
                                Margin="12"
                                MaxWidth="560"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="AzureMapsAuthenticationInfoBar"
                                AutomationProperties.LiveSetting="Assertive"
                                IsClosable="False"
                                IsOpen="False"/>
                            <Border
                                x:Name="PART_AttributionContainer"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="4"
                                Padding="4,2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PART_Attribution"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.AutomationId="MapAttribution"
                                    AutomationProperties.LiveSetting="Polite"
                                    MaxWidth="600"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </Border>
                            <Border
                                x:Name="FocusVisual"
                                BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
