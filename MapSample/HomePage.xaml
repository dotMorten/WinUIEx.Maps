<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            Margin="40,32"
            HorizontalAlignment="Left"
            Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="HomePage"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="WinUIEx.Maps samples" />
                <TextBlock
                    MaxWidth="760"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Explore Azure basemaps, custom raster tiles, map icon interaction, camera binding, and high-volume rendering."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Azure Maps service token" />
                        <TextBlock
                            MaxWidth="720"
                            Text="Azure basemap samples require an Azure Maps account key. The key is stored in the app's local settings for the next run."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <PasswordBox
                        x:Name="TokenInput"
                        MaxWidth="640"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="MapServiceTokenInput"
                        Header="MapServiceToken"
                        PasswordRevealMode="Peek"
                        PlaceholderText="Enter an Azure Maps account key" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            AutomationProperties.AutomationId="SaveMapServiceTokenButton"
                            Click="SaveToken_Click"
                            Content="Save token"
                            Style="{StaticResource AccentButtonStyle}" />
                        <HyperlinkButton
                            AutomationProperties.AutomationId="MapServiceTokenHelpLink"
                            Content="How to manage Azure Maps account keys"
                            NavigateUri="https://learn.microsoft.com/en-us/azure/azure-maps/how-to-manage-account-keys" />
                    </StackPanel>
                    <InfoBar
                        x:Name="SaveStatus"
                        AutomationProperties.AutomationId="MapServiceTokenSaveStatus"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Success"
                        Title="Token saved" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Samples" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Azure basemaps" />
                        <TextBlock Text="Select and display Azure Maps styles." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="OpenStreetMap tiles" />
                        <TextBlock Text="Render a custom HTTP raster tile layer without an Azure token." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Map icons" />
                        <TextBlock Text="Add, highlight, and delete topmost map elements." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Camera binding" />
                        <TextBlock Text="Two-way bind center and zoom to sliders." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Icon stress test" />
                        <TextBlock Text="Exercise 100,000 icons with continuous worker-thread updates." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
