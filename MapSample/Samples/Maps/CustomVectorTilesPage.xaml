<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Maps.CustomVectorTilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:local="using:MapSample.Samples.Maps"
    Loaded="Page_Loaded">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Margin="32,24,32,16" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="CustomVectorTilesPage"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Custom vector tiles" />
                <TextBlock Text="A custom TileLayer using an ArcGIS VectorTileServer and switchable Mapbox styles." />
            </StackPanel>
            <ComboBox
                x:Name="StylePicker"
                Grid.Column="1"
                MinWidth="190"
                AutomationProperties.AutomationId="CustomVectorTilesStyleInput"
                Header="Vector style"
                IsEnabled="False"
                SelectionChanged="StylePicker_SelectionChanged" >
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:StyleItem">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <InfoBar
            x:Name="LoadError"
            Grid.Row="1"
            Margin="32,0,32,16"
            IsClosable="False"
            IsOpen="False"
            Severity="Error"
            Title="ArcGIS vector tiles could not be loaded" />
        <map:MapControl
            x:Name="Map"
            Grid.Row="2"
            Margin="32,0,32,32"
            AutomationProperties.AutomationId="MapSurface"
            MapStyle="Blank" />
    </Grid>
</Page>
