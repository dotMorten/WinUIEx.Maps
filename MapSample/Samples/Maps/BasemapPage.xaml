<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Maps.BasemapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps">

    <Grid
        RowDefinitions="Auto,*">
        <Grid Margin="32,24,32,16" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="BasemapPage"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Azure basemaps" />
                <TextBlock Text="Choose an Azure Maps basemap style." />
            </StackPanel>
            <ComboBox
                x:Name="StylePicker"
                Grid.Column="1"
                MinWidth="220"
                AutomationProperties.AutomationId="MapStyleInput"
                Header="Map style" SelectedIndex="0"
                SelectionChanged="StylePicker_SelectionChanged" />
        </Grid>
        <Grid Grid.Row="1" Margin="32,0,32,32">
            <map:MapControl
                x:Name="Map"
                AutomationProperties.AutomationId="MapSurface"
                />
            <Button
                x:Name="GoToHomeButton"
                Margin="12,92,12,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="GoToHomeForTokenButton"
                Click="GoToHome_Click"
                Content="Add a token on Home"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
