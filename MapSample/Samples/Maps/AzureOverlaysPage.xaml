<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Maps.AzureOverlaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps">
    <Grid RowDefinitions="Auto,Auto,*" Margin="32,24,32,32" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock x:Name="Heading" Text="Azure traffic and weather" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="AzureOverlaysPage" />
            <TextBlock x:Name="Description" Text="Uses the Azure Maps token configured on Home." />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <StackPanel x:Name="TrafficOptions" Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="FlowPicker" Header="Traffic" SelectionChanged="OptionsChanged" />
                <CheckBox x:Name="Incidents" Content="Incidents" IsChecked="True"
                          Checked="ToggleChanged" Unchecked="ToggleChanged" />
                <NumberBox Header="Incident minimum zoom" Value="12" Minimum="0" Maximum="24"
                           SpinButtonPlacementMode="Compact" ValueChanged="IncidentZoomChanged" />
            </StackPanel>
            <StackPanel x:Name="WeatherOptions" Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="WeatherPicker" Header="Weather" SelectionChanged="OptionsChanged" />
                <ComboBox x:Name="TimePicker" Header="Frame" SelectionChanged="OptionsChanged" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2">
            <map:MapControl x:Name="Map" MapStyle="GrayscaleDark" />
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,12,12,48"
                    Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock x:Name="Status" Text="Latest imagery refreshes automatically. Fixed frames do not advance." />
            </Border>
        </Grid>
    </Grid>
</Page>
