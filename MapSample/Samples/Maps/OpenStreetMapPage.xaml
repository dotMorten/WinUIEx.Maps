<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Maps.OpenStreetMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps">

    <Grid
        RowDefinitions="Auto,*">
        <StackPanel Margin="32,24,32,16" Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="OpenStreetMapPage"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="OpenStreetMap custom tiles" />
            <TextBlock Text="A token-free custom TileLayer using OpenStreetMap XYZ tiles." />
        </StackPanel>
        <map:MapControl
            x:Name="Map"
            Grid.Row="1"
            Margin="32,0,32,32"
            AutomationProperties.AutomationId="MapSurface"
            MapStyle="Blank" />
    </Grid>
</Page>
