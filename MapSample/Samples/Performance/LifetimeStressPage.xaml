<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Performance.LifetimeStressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*">
        <Grid Margin="32,24,32,16" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="LifetimeStressPage"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Map lifetime stress" />
                <TextBlock Text="Creates a new MapControl every second, removes the previous instance, and reports process memory." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="MemoryStatus"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="LifetimeMemoryStatus"
                    Text="Inactive" />
                <ToggleButton
                    x:Name="LifetimeToggle"
                    AutomationProperties.AutomationId="LifetimeStressToggle"
                    Checked="LifetimeToggle_Checked"
                    Content="Run continuously"
                    Unchecked="LifetimeToggle_Unchecked" />
            </StackPanel>
        </Grid>
        <Grid
            x:Name="MapHost"
            Grid.Row="1"
            Margin="32,0,32,32" />
    </Grid>
</Page>
