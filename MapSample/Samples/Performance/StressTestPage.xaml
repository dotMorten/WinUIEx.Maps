<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Performance.StressTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps">

    <Grid
        RowDefinitions="Auto,*">
        <Grid Margin="32,24,32,16" ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="StressTestPage"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Icon stress test" />
                <TextBlock Text="Creates 100,000 icons and continuously updates 2,000 random icons per cycle." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="StressStatus"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="StressTestStatus"
                    Text="Inactive" />
                <ToggleButton
                    x:Name="StressToggle"
                    AutomationProperties.AutomationId="StressTestToggle"
                    Checked="StressToggle_Checked"
                    Content="Run stress test"
                    Unchecked="StressToggle_Unchecked" />
            </StackPanel>
        </Grid>
        <map:MapControl
            x:Name="Map"
            Grid.Row="1"
            Margin="32,0,32,32"
            AutomationProperties.AutomationId="MapSurface"
            MapStyle="Blank" />
    </Grid>
</Page>
