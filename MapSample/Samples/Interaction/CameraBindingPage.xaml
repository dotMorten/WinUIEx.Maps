<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Interaction.CameraBindingPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps">

    <Grid
        ColumnDefinitions="320,*">
        <ScrollViewer>
            <StackPanel Margin="32,24" Spacing="24">
                <StackPanel Spacing="4">
                    <TextBlock
                        AutomationProperties.AutomationId="CameraBindingPage"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Camera binding" />
                    <TextBlock Text="Center, ZoomLevel, Heading, and Pitch are two-way bound to sliders." TextWrapping="Wrap" />
                </StackPanel>
                <InfoBar
                    x:Name="TokenRequired"
                    AutomationProperties.AutomationId="MapServiceTokenRequired"
                    IsClosable="False"
                    IsOpen="False"
                    Message="Save a MapServiceToken on the Home page to display the Azure basemap."
                    Severity="Warning"
                    Title="MapServiceToken required" />
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="Longitude" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LongitudeText, Mode=OneWay}" />
                    </Grid>
                    <Slider
                        AutomationProperties.AutomationId="LongitudeSlider"
                        Minimum="-180"
                        Maximum="180"
                        StepFrequency="0.01"
                        Value="{x:Bind ViewModel.Longitude, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="Latitude" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LatitudeText, Mode=OneWay}" />
                    </Grid>
                    <Slider
                        AutomationProperties.AutomationId="LatitudeSlider"
                        Minimum="-85"
                        Maximum="85"
                        StepFrequency="0.01"
                        Value="{x:Bind ViewModel.Latitude, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="Zoom level" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}" />
                    </Grid>
                    <Slider
                        AutomationProperties.AutomationId="ZoomSlider"
                        Minimum="0"
                        Maximum="22"
                        StepFrequency="0.25"
                        Value="{x:Bind ViewModel.ZoomLevel, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="Heading" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HeadingText, Mode=OneWay}" />
                    </Grid>
                    <Slider
                        AutomationProperties.AutomationId="HeadingSlider"
                        Minimum="0"
                        Maximum="360"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.Heading, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="Pitch" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PitchText, Mode=OneWay}" />
                    </Grid>
                    <Slider
                        AutomationProperties.AutomationId="PitchSlider"
                        Minimum="0"
                        Maximum="60"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.Pitch, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <map:MapControl
            x:Name="Map"
            Grid.Column="1"
            Margin="0,24,32,32"
            AutomationProperties.AutomationId="MapSurface"
            Center="{x:Bind ViewModel.Center, Mode=TwoWay}"
            Heading="{x:Bind ViewModel.Heading, Mode=TwoWay}"
            MapStyle="Blank"
            Pitch="{x:Bind ViewModel.Pitch, Mode=TwoWay}"
            ZoomLevel="{x:Bind ViewModel.ZoomLevel, Mode=TwoWay}" />
    </Grid>
</Page>
