<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Interaction.TrySetViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps"
    xmlns:local="using:MapSample.Samples.Interaction">

    <Grid ColumnDefinitions="320,*">
        <ScrollViewer>
            <StackPanel Margin="32,24" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        AutomationProperties.AutomationId="TrySetViewPage"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Set camera view" />
                    <TextBlock
                        Text="Choose a destination and target orientation, then await TrySetViewAsync."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    x:Name="PresetPicker"
                    AutomationProperties.AutomationId="ViewPresetInput"
                    Header="Target destination">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ViewPreset">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <NumberBox
                    x:Name="HeadingInput"
                    AutomationProperties.AutomationId="TargetHeadingInput"
                    Header="Target heading"
                    LargeChange="15"
                    Maximum="360"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Value="0" />
                <NumberBox
                    x:Name="PitchInput"
                    AutomationProperties.AutomationId="TargetPitchInput"
                    Header="Target pitch"
                    LargeChange="10"
                    Maximum="60"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Value="0" />
                <ComboBox
                    x:Name="AnimationPicker"
                    AutomationProperties.AutomationId="MapAnimationKindInput"
                    Header="Animation kind" />
                <Button
                    AutomationProperties.AutomationId="TrySetViewButton"
                    Click="TrySetView_Click"
                    Content="Set view"
                    Style="{StaticResource AccentButtonStyle}" />
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Result" />
                    <TextBlock
                        x:Name="ResultText"
                        AutomationProperties.AutomationId="TrySetViewResult"
                        Text="true" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <map:MapControl
            x:Name="Map"
            Grid.Column="1"
            Margin="0,24,32,32"
            AutomationProperties.AutomationId="MapSurface"
            MapStyle="Blank" />
    </Grid>
</Page>
