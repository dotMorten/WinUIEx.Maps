<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Interaction.CurrentLocationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps"
    Loaded="Page_Loaded">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="32,24,32,16" Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="CurrentLocationPage"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Current location" />
            <TextBlock Text="Uses Windows location APIs to keep a MapIcon positioned at the latest reported location." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,0,32,32">
            <map:MapControl
                x:Name="Map"
                AutomationProperties.AutomationId="MapSurface"
                MapStyle="Blank" />
            <InfoBar
                x:Name="LocationStatus"
                Margin="12"
                MaxWidth="560"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="CurrentLocationStatus"
                IsClosable="False"
                IsOpen="True"
                Message="Allow location access when Windows prompts."
                Severity="Informational"
                Title="Requesting your location" />
        </Grid>
    </Grid>
</Page>
