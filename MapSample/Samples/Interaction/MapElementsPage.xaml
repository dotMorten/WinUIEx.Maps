<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MapSample.Samples.Interaction.MapElementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:map="using:WinUIEx.Maps">

    <Grid
        RowDefinitions="Auto,*">
        <StackPanel Margin="32,24,32,16" Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="MapElementsPage"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Interactive map elements" />
            <TextBlock Text="Hover over icons, lines, or polygons to highlight them. Left-click to add an icon, and right-click an icon to delete it." />
        </StackPanel>
        <Grid Grid.Row="1" Margin="32,0,32,32">
            <map:MapControl
                x:Name="Map"
                AutomationProperties.AutomationId="MapSurface"
                MapStyle="Blank" />
        </Grid>
    </Grid>
</Page>
